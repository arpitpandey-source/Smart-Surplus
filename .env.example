# Copy to .env (never commit .env)
# -------------------------------------------------------------------------
# Core application settings
# -------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# Set to "production" on Azure to disable debug mode and enable HTTPS cookies.
FLASK_ENV=development
APP_ENV=development

# -------------------------------------------------------------------------
# Azure SQL Database (leave blank to use local SQLite)
# -------------------------------------------------------------------------
# Install ODBC Driver 18 for SQL Server before setting this value.
# See: https://learn.microsoft.com/sql/connect/odbc/download-odbc-driver-for-sql-server
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=smartsurplus;Uid=smartsurplus_app;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# -------------------------------------------------------------------------
# Optional tuning
# -------------------------------------------------------------------------
# Hours before the deadline that "approaching deadline" notifications fire.
NOTIFY_DEADLINE_WINDOW_HOURS=24
